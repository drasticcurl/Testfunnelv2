# ══════════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO — Quiz Funnel multi-país (CL/CO/MX/PE/US)
# ══════════════════════════════════════════════════════════════════
#
# Copiá este archivo a `.env.local` y completá los valores reales.
# NUNCA subas `.env.local` al repositorio (está en `.gitignore`).
#
# Las vars `NEXT_PUBLIC_*` se exponen al browser. Las demás son server-only.
# ══════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────
# CHECKOUT — Hotmart (un solo producto en USD para los 5 países)
# ──────────────────────────────────────────────────────────────────
#
# Hotmart hace la conversión de moneda en su checkout: el comprador ve los
# precios en su moneda local y la venta se cobra en USD a tu cuenta. Por
# eso una sola URL por etapa del embudo (front / upsell / downsell) sirve
# para CL, CO, MX, PE y US.
#
# Cómo se obtienen las URLs:
#   Hotmart Admin → Productos → tu producto → Producer Page → "Vincular
#   página" / "Direct Link". Va a verse algo como:
#     https://pay.hotmart.com/A123456X
#   Para upsell/downsell tenés que tenerlos como productos separados (o el
#   mismo producto con "ofertas" distintas — Hotmart los expone como links
#   distintos también).
#
# La atribución (UTMs + país) viaja codificada en `?xcod=...` (ver
# `lib/cookies.ts → withCheckoutAttribution`). El webhook
# `/api/hotmart-webhook` la extrae de vuelta para guardarla en `purchases`.

NEXT_PUBLIC_HOTMART_CHECKOUT_URL=
NEXT_PUBLIC_HOTMART_UPSELL_CHECKOUT_URL=
NEXT_PUBLIC_HOTMART_DOWNSELL_CHECKOUT_URL=


# ──────────────────────────────────────────────────────────────────
# WEBHOOK DE HOTMART
# ──────────────────────────────────────────────────────────────────
#
# Token que valida que el webhook venga de Hotmart (header `x-hotmart-hottok`).
#
# Cómo obtenerlo:
#   Hotmart Admin → Tools → Webhooks → tu webhook → "HOTTOK".
#
# URL del webhook que tenés que configurar en Hotmart:
#   https://TU-DOMINIO/api/hotmart-webhook
#
# Eventos a habilitar: PURCHASE_APPROVED, PURCHASE_COMPLETE, PURCHASE_REFUNDED,
# PURCHASE_CHARGEBACK, PURCHASE_CANCELED.
#
# Sin esto: el endpoint acepta requests sin validar (logea warning).
# OBLIGATORIO en producción para que nadie pueda mandar compras falsas.
HOTMART_HOTTOK=


# ──────────────────────────────────────────────────────────────────
# SUPABASE (DB de leads, compras y embudo)
# ──────────────────────────────────────────────────────────────────
#
# Crear proyecto en https://supabase.com → Settings → API → copiar:
#   - URL → SUPABASE_URL y NEXT_PUBLIC_SUPABASE_URL (mismo valor en las dos)
#   - service_role key → SUPABASE_SERVICE_ROLE_KEY
#
# IMPORTANTE: ANTES de levantar el deploy, abrí
#   Supabase → SQL Editor → New query
# y pegá el contenido entero de `supabase/setup.sql`. Eso crea las 3 tablas
# (`clientes`, `purchases`, `funnel_counts`) + los RPCs e índices.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Backend de almacenamiento del funnel.
#   memory   = en memoria (se pierde al re-deploy, sirve para dev local).
#   supabase = persistente. Requiere las vars de Supabase de arriba.
FUNNEL_STORE=supabase


# ──────────────────────────────────────────────────────────────────
# META PIXEL + CAPI (tracking de conversiones)
# ──────────────────────────────────────────────────────────────────
#
# Pixel ID — 15-16 dígitos. Va a:
#   - NEXT_PUBLIC_META_PIXEL_ID → cliente (lo inyecta `app/layout.tsx`)
#   - META_PIXEL_ID             → server (sin NEXT_PUBLIC para no exponerlo)
# Son el mismo valor.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=

# Token de la Conversions API (server-side). Se genera en:
#   Events Manager → tu pixel → Settings → Conversions API → Generate Access Token
# Sin esto, los endpoints `/api/track`, `/api/submit-quiz` y
# `/api/hotmart-webhook` siguen funcionando pero NO mandan eventos a Meta
# server-side (peor matching, peor optimización de ads).
META_CAPI_TOKEN=


# ──────────────────────────────────────────────────────────────────
# ADMIN DASHBOARD (`/admin`)
# ──────────────────────────────────────────────────────────────────
#
# Password para acceder al panel admin. Mínimo 24 caracteres recomendado.
# Generarlo con: openssl rand -base64 32
ADMIN_PASSWORD=


# ──────────────────────────────────────────────────────────────────
# PWA POST-COMPRA (`/pwa`)
# ──────────────────────────────────────────────────────────────────
#
# Test mode: cuando es "true", la PWA acepta cualquier email sin validar
# contra `purchases`. Útil para desarrollo y para QA visual de las páginas.
# DESACTIVAR en producción.
NEXT_PUBLIC_PWA_TEST_MODE=true

# Secret para firmar la cookie de sesión PWA (HMAC SHA-256). REQUERIDO en
# producción cuando NEXT_PUBLIC_PWA_TEST_MODE=false. Mínimo 16 chars.
# Generarlo con: openssl rand -hex 32
PWA_SESSION_SECRET=

# URL base de la PWA (a donde redirige el "no gracias" del downsell).
NEXT_PUBLIC_PWA_BASE_URL=https://tu-dominio.com/pwa/login


# ──────────────────────────────────────────────────────────────────
# GEO-BLOCK (opcional)
# ──────────────────────────────────────────────────────────────────
#
# Códigos ISO 3166-1 alpha-2 separados por coma. Default: "BR".
# Las visitas desde estos países reciben 451 antes de llegar al quiz.
# (No aplica a /api/* — el webhook de Hotmart sigue funcionando aunque
# venga desde un país bloqueado.)
BLOCKED_COUNTRIES=BR


# ──────────────────────────────────────────────────────────────────
# VSL DEL UPSELL — VTURB (opcional, /upsell)
# ──────────────────────────────────────────────────────────────────
#
# El bloque VSL del upsell usa VTURB. El snippet que te da VTURB tiene
# 2 datos que van acá:
#   1. id del player (ves en <vturb-smartplayer id="vid-XXXXXXXX">)
#   2. URL del player.js (https://scripts.converteai.net/.../player.js)
#
# Sin esto: /upsell muestra un placeholder 16:9 (no rompe).
NEXT_PUBLIC_VTURB_PLAYER_ID=
NEXT_PUBLIC_VTURB_SCRIPT_URL=

# Segundos del VSL hasta que aparece el bloque de oferta.
# Sincronizar con el punto "[ACÁ SALE EL PRECIO]" del guion (~11:40 = 700s).
NEXT_PUBLIC_VSL_OFFER_DELAY_SEC=700

# Duración del contador de escasez del bloque de oferta (07:47 = 467).
NEXT_PUBLIC_VSL_COUNTDOWN_SEC=467


# ──────────────────────────────────────────────────────────────────
# QUIZ WEBHOOK (opcional — Make.com / Zapier / Sheets)
# ──────────────────────────────────────────────────────────────────
#
# Si querés un mirror de los leads en una hoja de Google o un workflow de
# Zapier/Make, pegá la URL del webhook acá. `/api/submit-quiz` reenvía cada
# lead completo (todas las respuestas + tipo + severidad + país) por POST.
# Vacío = sin reenvío (warning en consola).
QUIZ_WEBHOOK_URL=
