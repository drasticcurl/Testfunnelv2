# ══════════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO — Quiz Funnel Anti-Hinchazón
# ══════════════════════════════════════════════════════════════════
#
# Copiá este archivo a .env.local y completá los valores reales.
# NUNCA subas .env.local al repositorio (está en .gitignore).
# ══════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────
# TRACKING — Cookie cross-subdominio de UTMs
# ──────────────────────────────────────────────────────────────────
#
# Dominio para la cookie que persiste los UTMs (utm_source, utm_medium, etc).
# Se comparte entre TODOS los subdominios del dominio indicado, así los UTMs
# sobreviven el recorrido app ↔ checkout y las ventas del upsell/upsell2 quedan
# atribuidas por UTM en Shopify (igual que el checkout del front).
#
#   Producción:  .hilvanapp.com   (nota el punto inicial → incluye subdominios:
#                                   tienda.hilvanapp.com, chauhinchazon.hilvanapp.com)
#   Local/preview: dejar VACÍO     → cookie host-only (evita rechazos en *.vercel.app)
#
# Si el host actual NO es subdominio de este valor, el browser rechaza la cookie
# (por eso no se hardcodea). Con esta var vacía, cae a localStorage como fallback.
NEXT_PUBLIC_COOKIE_DOMAIN=


# ──────────────────────────────────────────────────────────────────
# AGENTE 02 (Quiz Engine)
# ──────────────────────────────────────────────────────────────────

# URL del webhook de Make.com / Zapier que recibe los datos del quiz.
# El webhook debe:
#   1. Logear en Google Sheets para metricas (ver _METRICAS.md)
#   2. (Opcional) Backup de Systeme.io si la API directa falla
#
# [NEEDS_INPUT] Crear el escenario en Make.com y pegar la URL aca.
# Si NO esta configurado: el endpoint /api/submit-quiz funciona igual,
# solo no se reenvia al webhook (warning en consola).
QUIZ_WEBHOOK_URL=


# ──────────────────────────────────────────────────────────────────
# AGENTE 03 (Pagina de Resultados)
# ──────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────
# CHECKOUT — SHOPIFY (provider actual)
# ─────────────────────────────────────────────
#
# URL del checkout del producto FRONT (Plan 7 días — $8.000 ARS).
# En Shopify se usa un PERMALINK DE CARRITO que precarga el producto:
#    https://TU-TIENDA.myshopify.com/cart/{VARIANT_ID}:1
# (o el subdominio propio, ej: https://tienda.hilvanapp.com/cart/{VARIANT_ID}:1)
# El VARIANT_ID lo sacás del producto en Shopify Admin.
# Se le agregan UTMs + ?src=quiz_v3 automaticamente.
#
# [NEEDS_INPUT] Crear la tienda + producto en Shopify y pegar el permalink.
# Sin este valor: el CTA apunta a un placeholder que NO procesa pagos.
NEXT_PUBLIC_CHECKOUT_URL=

# (LEGACY / fallback) URL de checkout de Hotmart. Si NEXT_PUBLIC_CHECKOUT_URL
# está vacía, se usa esta. Dejar vacío si ya migraste a Shopify.
NEXT_PUBLIC_HOTMART_CHECKOUT_URL=

# URL del checkout del UPSELL (Programa 30 Días — $19.900 ARS).
# Es el SEGUNDO producto, distinto al front. En Shopify, su permalink de carrito:
#    https://TU-TIENDA.myshopify.com/cart/{VARIANT_ID_UPSELL}:1
# (puede vivir en la MISMA tienda o, modelo competidor, en una tienda separada).
# Al aceptar el upsell, /upsell2 redirige a esta URL (NO iframe — Shopify no
# permite embed). Tras pagar, Shopify dispara orders/paid → /api/shopify-webhook.
#
# [NEEDS_INPUT] Configurar después de crear el producto upsell en Shopify.
# Sin este valor: /upsell2 muestra un fallback que avisa que falta configuración.
NEXT_PUBLIC_UPSELL_CHECKOUT_URL=

# (LEGACY / fallback) checkout del upsell en Hotmart. Dejar vacío si migraste.
NEXT_PUBLIC_HOTMART_UPSELL_CHECKOUT_URL=

# URL del checkout del UPSELL 2 (Acceso VIP de por vida — $19.990 ARS, pago único).
# Es el TERCER producto del embudo, distinto al front y al upsell de 30 días.
# En Shopify, su permalink de carrito:
#    https://TU-TIENDA.myshopify.com/cart/{VARIANT_ID_VIP}:1
# El VARIANT_ID_VIP lo sacás del producto VIP en Shopify Admin.
# Al aceptar en /upsell2, se redirige a esta URL (con UTMs + ?src=upsell2).
# Tras pagar, Shopify dispara orders/paid → /api/shopify-webhook.
#
# [NEEDS_INPUT] Configurar después de crear el producto VIP en Shopify.
# Sin este valor: /upsell2 muestra un fallback que avisa que falta configuración.
NEXT_PUBLIC_UPSELL2_CHECKOUT_URL=

# URL del checkout del DOWNSELL (mismo Programa 30 Días — $9.900 ARS, $5.000 menos).
# Se muestra en /downsell cuando el usuario rechaza el upsell.
# Es el MISMO producto que el upsell pero a menor precio. En Shopify lo armás con:
#   - una VARIANTE distinta más barata, o
#   - el mismo producto con un descuento automático en el permalink:
#     https://TU-TIENDA.myshopify.com/cart/{VARIANT_ID}:1?discount=CODIGO
#
# [NEEDS_INPUT] Configurar después de crear la oferta de downsell en Shopify.
# Sin este valor: /downsell avisa que falta configuración.
NEXT_PUBLIC_DOWNSELL_CHECKOUT_URL=

# (LEGACY / fallback) checkout del downsell en Hotmart. Dejar vacío si migraste.
NEXT_PUBLIC_HOTMART_DOWNSELL_CHECKOUT_URL=

# URL base de la PWA (a donde redirige el "no gracias" del upsell).
# En producción: https://chauhinchazon.hilvanapp.com/pwa/login
# En dev:        http://localhost:3000/pwa/login
NEXT_PUBLIC_PWA_BASE_URL=


# ─────────────────────────────────────────────
# VSL DEL UPSELL — VTURB (ConverteAI smartplayer)
# ─────────────────────────────────────────────
#
# El upsell (/upsell) muestra un VSL embebido con VTURB. El snippet que te da
# VTURB tiene 2 datos que van acá:
#   1. el id del player (lo ves en <vturb-smartplayer id="vid-XXXXXXXX">)
#   2. la URL del player.js (algo como
#      https://scripts.converteai.net/TU_ID/players/TU_PLAYER/player.js)
#
# Sin estos valores: /upsell muestra un placeholder con aspecto 16:9 (no rompe).
NEXT_PUBLIC_VTURB_PLAYER_ID=
NEXT_PUBLIC_VTURB_SCRIPT_URL=

# Segundos del VSL hasta que aparece el bloque de oferta (precio + CTA + contador).
# Sincronizar con el punto "[ACÁ SALE EL PRECIO]" del guion (~11:40 = 700s).
# Default: 700. Poné 0 para mostrar la oferta de entrada (útil para testear).
NEXT_PUBLIC_VSL_OFFER_DELAY_SEC=700

# Duración del contador de escasez del bloque de oferta, en segundos.
# 07:47 = 467 (default).
NEXT_PUBLIC_VSL_COUNTDOWN_SEC=467


# ──────────────────────────────────────────────────────────────────
# AGENTE 04 (API + Tracking)
# ──────────────────────────────────────────────────────────────────

# ─── Meta Pixel (client-side, expuesto al browser) ───
# ID del pixel de Meta. 15-16 digitos. Se inyecta en app/layout.tsx
# para los eventos client-side (PageView, QuizStart, etc).
NEXT_PUBLIC_META_PIXEL_ID=


# ─── Meta Conversions API (server-side) ───
# El pixel ID es el mismo que arriba, pero acaaca SIN prefijo NEXT_PUBLIC_
# (asi NO se expone al cliente).
META_PIXEL_ID=

# Token de acceso de la CAPI. Se genera en:
# Events Manager > tu pixel > Settings > Conversions API > Generate Access Token
# Sin esto: los endpoints /api/track, /api/submit-quiz, /api/hotmart-webhook
# logean warning y siguen funcionando, pero NO mandan eventos a Meta server-side.
META_CAPI_TOKEN=


# ─── TikTok Pixel + Events API (paralelo a Meta, NO lo reemplaza) ───
# Tracking de TikTok Ads, montado en espejo del de Meta y 100% ADITIVO:
# si estas vars están vacías, TikTok no se inicializa y Meta sigue igual.
#
# Pixel ID (client-side, expuesto al browser). Se inyecta en app/layout.tsx
# como el base code de `ttq` (PageView vía ttq.page()) y dispara los eventos
# custom (ViewContent, InitiateCheckout, CompletePayment) al lado de los `fbq`.
# Lo sacás de: TikTok Events Manager > tu pixel > Install pixel > base code.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Mismo pixel code que arriba, SIN prefijo NEXT_PUBLIC_ (server-only). Lo usa la
# Events API 2.0 (server-side) como `event_source_id`. Suele ser el mismo valor
# que NEXT_PUBLIC_TIKTOK_PIXEL_ID; se separa para no exponer intención server.
TIKTOK_PIXEL_ID=

# Access Token de la Events API de TikTok. Se genera en:
# TikTok Events Manager > tu pixel > Settings > Events API > Generate Access Token
# Sin esto: /api/track y /api/shopify-webhook logean warning y NO mandan eventos
# server-side a TikTok (el pixel client-side sigue funcionando igual).
TIKTOK_ACCESS_TOKEN=


# ─── Systeme.io ───
# API Key de Systeme.io para crear contactos con tags.
# Settings > API Keys en el panel de Systeme.
# Sin esto: los contactos NO se agregan automaticamente a Systeme
# (warning en consola). Podes usar Make.com como fallback via QUIZ_WEBHOOK_URL.
SYSTEME_API_KEY=


# ─── Shopify Webhook (provider actual) ───
# Secret(s) con los que Shopify firma sus webhooks (HMAC-SHA256 base64 del raw
# body, header X-Shopify-Hmac-Sha256). Lo obtenés al crear el webhook en:
#   Shopify Admin > Settings > Notifications > Webhooks  (o en la app que uses)
# Topic a configurar: "Order payment" (orders/paid).
# URL del webhook que le das a Shopify:
#   https://chauhinchazon.hilvanapp.com/api/shopify-webhook
#
# MULTI-TIENDA: si usás varias tiendas (ej: front + upsell separados), pegá
# todos los secrets separados por COMA. Si CUALQUIERA valida, se acepta.
#   SHOPIFY_WEBHOOK_SECRETS=secret_tienda_front,secret_tienda_upsell
#
# Sin esto: el endpoint acepta requests sin validar (logea warning). CONFIGURALO
# en producción para que nadie pueda mandar compras falsas.
SHOPIFY_WEBHOOK_SECRETS=

# ─── Hotmart Webhook (LEGACY AR + FUNNEL LATAM) ───
# El "hottok" valida el webhook /api/hotmart-webhook. Lo usa tanto el flujo
# legacy de AR como el funnel LATAM (USD). Dejar vacío sólo si NO recibís
# ventas por Hotmart en ningún funnel.
HOTMART_HOTTOK=


# ══════════════════════════════════════════════════════════════════
# FUNNEL LATAM (Hotmart, USD)
# ══════════════════════════════════════════════════════════════════
#
# Funnel PARALELO al de AR. Vende en USD vía HOTMART (el de AR usa Shopify/ARS).
# Páginas: /latam (front), /upsell-latam, /downsell-latam.
# NO toca ni rompe el funnel argentino: son rutas y vars separadas.
#
# Checkouts de Hotmart (NEXT_PUBLIC_* → se exponen al browser):

# Checkout del FRONT en Hotmart (US$5.90). Lo usa /latam.
# Sin este valor: el CTA de /latam avisa que falta configuración (no rompe).
NEXT_PUBLIC_LATAM_CHECKOUT_URL=

# Checkout del UPSELL en Hotmart (US$13.90). Lo usa /upsell-latam.
NEXT_PUBLIC_LATAM_UPSELL_CHECKOUT_URL=

# Checkout del DOWNSELL en Hotmart (US$9.90). Lo usa /downsell-latam.
NEXT_PUBLIC_LATAM_DOWNSELL_CHECKOUT_URL=

# ─── UPSELL 2 / VIP (LATAM) — Acceso VIP de por vida ───
# Checkout del UPSELL 2 en Hotmart (US$27, pago único). Lo usa /upsell2-latam.
# Sin este valor: el CTA de /upsell2-latam avisa que falta configuración (no rompe).
NEXT_PUBLIC_LATAM_UPSELL2_CHECKOUT_URL=

# Checkout del DOWNSELL 2 en Hotmart (US$17). MISMO producto VIP, precio menor.
# Lo usa /downsell2-latam. Sin este valor: el CTA avisa "config pendiente".
NEXT_PUBLIC_LATAM_DOWNSELL2_CHECKOUT_URL=

# Código estático que desbloquea la sección VIP de la PWA (/pwa/vip).
# OPCIONAL: si no se setea, el default es 'VIPLATAM'. Se entrega por el email
# NATIVO de Hotmart post-compra (tanto upsell 2 como downsell 2 usan el MISMO
# código, porque son el mismo producto VIP). NO es seguridad fuerte (es
# compartible): es exclusividad percibida, sin SQL ni autenticación detrás.
NEXT_PUBLIC_VIP_CODE_LATAM=

# ─── Detección de plan en el webhook (LATAM) ───
# HOTMART_HOTTOK (arriba) valida el webhook /api/hotmart-webhook.
# Estos PRODUCT IDs manejan la detección de plan en handleApproved():
# en USD ya no sirve detectar por precio, así que se compara product.id contra
# estas vars. upsell → plan '4sem'; front → plan '1sem'; default → '1sem'.
# El PRODUCT ID lo ves en Hotmart > Productos (o en el payload del webhook).
HOTMART_PRODUCT_ID_FRONT=
HOTMART_PRODUCT_ID_UPSELL=
# (Opcional) order bump, si lo activás en Hotmart.
# HOTMART_PRODUCT_ID_BUMP=

# ─── Meta Pixel / ads (LATAM) ───
# El funnel LATAM usa el MISMO Meta Pixel que AR (NEXT_PUBLIC_META_PIXEL_ID).
# El evento Purchase se dispara SERVER-SIDE desde el webhook CAPI de Hotmart
# (/api/hotmart-webhook). Por eso NO actives la integración nativa de Meta Pixel
# de Hotmart: duplicaría las conversiones (double-count).
# Segmentación de ads: apuntar a LATAM EXCLUYENDO AR y BR (BR queda geo-bloqueado).


# ══════════════════════════════════════════════════════════════════
# DEPLOY (Vercel)
# ══════════════════════════════════════════════════════════════════
#
# Antes de hacer deploy, configurar estas variables en:
#   Vercel > Project > Settings > Environment Variables
#
# Variables NEXT_PUBLIC_* se exponen al browser (necesario).
# Las demas son server-only.
# ══════════════════════════════════════════════════════════════════



# ──────────────────────────────────────────────────────────────────
# ADMIN DASHBOARD — Funnel Analytics
# ──────────────────────────────────────────────────────────────────

# Password para acceder a /admin. Mínimo 24 caracteres recomendado.
# Generar con: openssl rand -base64 32
ADMIN_PASSWORD=

# Backend de almacenamiento del funnel. Opciones:
#   memory   — en memoria (se pierde al re-deploy). Default si no se configura.
#   supabase — persistente en Supabase (requiere las vars de Supabase abajo).
FUNNEL_STORE=supabase


# ──────────────────────────────────────────────────────────────────
# TEST FULL-FUNNEL A/B — ARGENTINA (Funnel A control vs Funnel B rebrand)
# ──────────────────────────────────────────────────────────────────
#
# KILL SWITCH del test full-funnel SOLO de Argentina. Compara el funnel ACTUAL
# (Funnel A / control) contra una variante rebrandeada rosa/femenina (Funnel B)
# con una sales page v2. El experimento está ACTIVO únicamente cuando el valor
# es exactamente 'true'.
#
#   - vacío / cualquier valor ≠ 'true'  → OFF: TODO el tráfico AR ve Funnel A y
#     el sistema se comporta EXACTAMENTE como hoy (cero cambios). Además, el test
#     de entrada ab_entry sigue randomizando normal.
#   - 'true'                            → ON: 50/50 A|B por navegador (estable),
#     se PAUSA la randomización de ab_entry (fijada a su default) y se emiten los
#     eventos internos af_<V>_* hacia /admin/funnel.
#
# LATAM NUNCA participa. QA: forzá una variante con ?af=A (o B) en la URL del quiz.
NEXT_PUBLIC_AB_FUNNEL_ENABLED=


# ──────────────────────────────────────────────────────────────────
# PWA — Protocolo Anti-Hinchazón App
# ──────────────────────────────────────────────────────────────────

# Test mode: cuando es "true", la PWA funciona sin Supabase.
# Login acepta cualquier email, acceso completo a todas las features.
# Usar para desarrollo y testeo visual. DESACTIVAR en producción.
NEXT_PUBLIC_PWA_TEST_MODE=true

# [DEPRECADO] Secret para firmar la cookie de sesión PWA (HMAC SHA-256).
# Ya NO se usa: la PWA migró a Supabase Auth (email+password). Esta variable
# quedó obsoleta y se puede eliminar de tu entorno sin efectos.
PWA_SESSION_SECRET=

# Supabase (necesario para PWA cuando PWA_TEST_MODE=false Y para FUNNEL_STORE=supabase)
#
# AUTH DE LA PWA: ahora se usa Supabase Auth (email+password) para login/registro.
#  - NEXT_PUBLIC_SUPABASE_ANON_KEY es REQUERIDA (login/registro corren client-side).
#  - Para emails de recuperación de contraseña, configurá un SMTP propio en el
#    dashboard de Supabase: Authentication > SMTP Settings
#    (ej. Brevo: host smtp-relay.brevo.com, puerto 587).
#  - Desactivá "Confirm email" en Authentication > Providers > Email para que el
#    registro entre directo sin paso de confirmación por correo.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# REQUERIDO para Supabase Auth (login/registro client-side de la PWA).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Supabase (URL duplicada sin NEXT_PUBLIC para uso server-only en lib/supabase.ts)
SUPABASE_URL=https://xxxxx.supabase.co


# ──────────────────────────────────────────────────────────────────
# EMAILS TRANSACCIONALES (Resend)
# ──────────────────────────────────────────────────────────────────

# API Key de Resend. Obtener en: https://resend.com/api-keys
# Sin esto: no se envían emails post-quiz (funnel sigue funcionando).
RESEND_API_KEY=

# Email From. Debe ser un dominio verificado en Resend.
# Formato: "Nombre <email@dominio.com>"
RESEND_FROM_EMAIL=Protocolo Anti-Hinchazón <hola@anti-hinchazon.com>

# URL base del sitio (para links en los emails)
NEXT_PUBLIC_SITE_URL=https://anti-hinchazon.com

# Hotmart Product IDs (para mapear webhook → tier de acceso)
# Movidos a la sección "FUNNEL LATAM (Hotmart, USD)" más arriba
# (HOTMART_PRODUCT_ID_FRONT / HOTMART_PRODUCT_ID_UPSELL / _BUMP).

# URL de la app (para magic links redirect)
# NEXT_PUBLIC_APP_URL=https://tudominio.com
