# ══════════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO — Quiz Funnel Anti-Hinchazón
# ══════════════════════════════════════════════════════════════════
#
# Copiá este archivo a .env.local y completá los valores reales.
# NUNCA subas .env.local al repositorio (está en .gitignore).
# ══════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────
# AGENTE 02 (Quiz Engine)
# ──────────────────────────────────────────────────────────────────

# URL del webhook de Make.com / Zapier que recibe los datos del quiz.
# El webhook debe:
#   1. Logear en Google Sheets para metricas (ver _METRICAS.md)
#   2. (Opcional) Backup de Systeme.io si la API directa falla
#
# [NEEDS_INPUT] Crear el escenario en Make.com y pegar la URL aca.
# Si NO esta configurado: el endpoint /api/submit-quiz funciona igual,
# solo no se reenvia al webhook (warning en consola).
QUIZ_WEBHOOK_URL=


# ──────────────────────────────────────────────────────────────────
# AGENTE 03 (Pagina de Resultados)
# ──────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────
# CHECKOUT — SHOPIFY (provider actual)
# ─────────────────────────────────────────────
#
# URL del checkout del producto FRONT (Plan 7 días — $6.000 ARS).
# En Shopify se usa un PERMALINK DE CARRITO que precarga el producto:
#    https://TU-TIENDA.myshopify.com/cart/{VARIANT_ID}:1
# (o el subdominio propio, ej: https://tienda.hilvanapp.com/cart/{VARIANT_ID}:1)
# El VARIANT_ID lo sacás del producto en Shopify Admin.
# Se le agregan UTMs + ?src=quiz_v3 automaticamente.
#
# [NEEDS_INPUT] Crear la tienda + producto en Shopify y pegar el permalink.
# Sin este valor: el CTA apunta a un placeholder que NO procesa pagos.
NEXT_PUBLIC_CHECKOUT_URL=

# (LEGACY / fallback) URL de checkout de Hotmart. Si NEXT_PUBLIC_CHECKOUT_URL
# está vacía, se usa esta. Dejar vacío si ya migraste a Shopify.
NEXT_PUBLIC_HOTMART_CHECKOUT_URL=

# URL del checkout del UPSELL (Programa 30 Días — $19.900 ARS).
# Es el SEGUNDO producto, distinto al front. En Shopify, su permalink de carrito:
#    https://TU-TIENDA.myshopify.com/cart/{VARIANT_ID_UPSELL}:1
# (puede vivir en la MISMA tienda o, modelo competidor, en una tienda separada).
# Al aceptar el upsell, /upsell2 redirige a esta URL (NO iframe — Shopify no
# permite embed). Tras pagar, Shopify dispara orders/paid → /api/shopify-webhook.
#
# [NEEDS_INPUT] Configurar después de crear el producto upsell en Shopify.
# Sin este valor: /upsell2 muestra un fallback que avisa que falta configuración.
NEXT_PUBLIC_UPSELL_CHECKOUT_URL=

# (LEGACY / fallback) checkout del upsell en Hotmart. Dejar vacío si migraste.
NEXT_PUBLIC_HOTMART_UPSELL_CHECKOUT_URL=

# URL del checkout del DOWNSELL (mismo Programa 30 Días — $9.900 ARS, $5.000 menos).
# Se muestra en /downsell cuando el usuario rechaza el upsell.
# Es el MISMO producto que el upsell pero a menor precio. En Shopify lo armás con:
#   - una VARIANTE distinta más barata, o
#   - el mismo producto con un descuento automático en el permalink:
#     https://TU-TIENDA.myshopify.com/cart/{VARIANT_ID}:1?discount=CODIGO
#
# [NEEDS_INPUT] Configurar después de crear la oferta de downsell en Shopify.
# Sin este valor: /downsell avisa que falta configuración.
NEXT_PUBLIC_DOWNSELL_CHECKOUT_URL=

# (LEGACY / fallback) checkout del downsell en Hotmart. Dejar vacío si migraste.
NEXT_PUBLIC_HOTMART_DOWNSELL_CHECKOUT_URL=

# URL base de la PWA (a donde redirige el "no gracias" del upsell).
# En producción: https://chauhinchazon.hilvanapp.com/pwa/login
# En dev:        http://localhost:3000/pwa/login
NEXT_PUBLIC_PWA_BASE_URL=


# ─────────────────────────────────────────────
# VSL DEL UPSELL — VTURB (ConverteAI smartplayer)
# ─────────────────────────────────────────────
#
# El upsell (/upsell) muestra un VSL embebido con VTURB. El snippet que te da
# VTURB tiene 2 datos que van acá:
#   1. el id del player (lo ves en <vturb-smartplayer id="vid-XXXXXXXX">)
#   2. la URL del player.js (algo como
#      https://scripts.converteai.net/TU_ID/players/TU_PLAYER/player.js)
#
# Sin estos valores: /upsell muestra un placeholder con aspecto 16:9 (no rompe).
NEXT_PUBLIC_VTURB_PLAYER_ID=
NEXT_PUBLIC_VTURB_SCRIPT_URL=

# Segundos del VSL hasta que aparece el bloque de oferta (precio + CTA + contador).
# Sincronizar con el punto "[ACÁ SALE EL PRECIO]" del guion (~11:40 = 700s).
# Default: 700. Poné 0 para mostrar la oferta de entrada (útil para testear).
NEXT_PUBLIC_VSL_OFFER_DELAY_SEC=700

# Duración del contador de escasez del bloque de oferta, en segundos.
# 07:47 = 467 (default).
NEXT_PUBLIC_VSL_COUNTDOWN_SEC=467


# ──────────────────────────────────────────────────────────────────
# AGENTE 04 (API + Tracking)
# ──────────────────────────────────────────────────────────────────

# ─── Meta Pixel (client-side, expuesto al browser) ───
# ID del pixel de Meta. 15-16 digitos. Se inyecta en app/layout.tsx
# para los eventos client-side (PageView, QuizStart, etc).
NEXT_PUBLIC_META_PIXEL_ID=


# ─── Meta Conversions API (server-side) ───
# El pixel ID es el mismo que arriba, pero acaaca SIN prefijo NEXT_PUBLIC_
# (asi NO se expone al cliente).
META_PIXEL_ID=

# Token de acceso de la CAPI. Se genera en:
# Events Manager > tu pixel > Settings > Conversions API > Generate Access Token
# Sin esto: los endpoints /api/track, /api/submit-quiz, /api/hotmart-webhook
# logean warning y siguen funcionando, pero NO mandan eventos a Meta server-side.
META_CAPI_TOKEN=


# ─── Systeme.io ───
# API Key de Systeme.io para crear contactos con tags.
# Settings > API Keys en el panel de Systeme.
# Sin esto: los contactos NO se agregan automaticamente a Systeme
# (warning en consola). Podes usar Make.com como fallback via QUIZ_WEBHOOK_URL.
SYSTEME_API_KEY=


# ─── Shopify Webhook (provider actual) ───
# Secret(s) con los que Shopify firma sus webhooks (HMAC-SHA256 base64 del raw
# body, header X-Shopify-Hmac-Sha256). Lo obtenés al crear el webhook en:
#   Shopify Admin > Settings > Notifications > Webhooks  (o en la app que uses)
# Topic a configurar: "Order payment" (orders/paid).
# URL del webhook que le das a Shopify:
#   https://chauhinchazon.hilvanapp.com/api/shopify-webhook
#
# MULTI-TIENDA: si usás varias tiendas (ej: front + upsell separados), pegá
# todos los secrets separados por COMA. Si CUALQUIERA valida, se acepta.
#   SHOPIFY_WEBHOOK_SECRETS=secret_tienda_front,secret_tienda_upsell
#
# Sin esto: el endpoint acepta requests sin validar (logea warning). CONFIGURALO
# en producción para que nadie pueda mandar compras falsas.
SHOPIFY_WEBHOOK_SECRETS=

# ─── Hotmart Webhook (LEGACY) ───
# Solo si seguís recibiendo ventas de Hotmart en paralelo. El "hottok" valida el
# webhook legacy /api/hotmart-webhook. Dejar vacío si ya cortaste Hotmart.
HOTMART_HOTTOK=


# ══════════════════════════════════════════════════════════════════
# DEPLOY (Vercel)
# ══════════════════════════════════════════════════════════════════
#
# Antes de hacer deploy, configurar estas variables en:
#   Vercel > Project > Settings > Environment Variables
#
# Variables NEXT_PUBLIC_* se exponen al browser (necesario).
# Las demas son server-only.
# ══════════════════════════════════════════════════════════════════



# ──────────────────────────────────────────────────────────────────
# ADMIN DASHBOARD — Funnel Analytics
# ──────────────────────────────────────────────────────────────────

# Password para acceder a /admin. Mínimo 24 caracteres recomendado.
# Generar con: openssl rand -base64 32
ADMIN_PASSWORD=

# Backend de almacenamiento del funnel. Opciones:
#   memory   — en memoria (se pierde al re-deploy). Default si no se configura.
#   supabase — persistente en Supabase (requiere las vars de Supabase abajo).
FUNNEL_STORE=supabase


# ──────────────────────────────────────────────────────────────────
# PWA — Protocolo Anti-Hinchazón App
# ──────────────────────────────────────────────────────────────────

# Test mode: cuando es "true", la PWA funciona sin Supabase.
# Login acepta cualquier email, acceso completo a todas las features.
# Usar para desarrollo y testeo visual. DESACTIVAR en producción.
NEXT_PUBLIC_PWA_TEST_MODE=true

# Secret para firmar la cookie de sesión PWA (HMAC SHA-256).
# REQUERIDO en producción cuando NEXT_PUBLIC_PWA_TEST_MODE=false.
# Mínimo 16 caracteres. Generar con: openssl rand -hex 32
# Si lo cambias después de tener usuarios logueados, todas las sesiones
# existentes se invalidan y deberán re-loguear (no es un problema grave,
# pero conviene saberlo).
PWA_SESSION_SECRET=

# Supabase (necesario para PWA cuando PWA_TEST_MODE=false Y para FUNNEL_STORE=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Supabase (URL duplicada sin NEXT_PUBLIC para uso server-only en lib/supabase.ts)
SUPABASE_URL=https://xxxxx.supabase.co


# ──────────────────────────────────────────────────────────────────
# EMAILS TRANSACCIONALES (Resend)
# ──────────────────────────────────────────────────────────────────

# API Key de Resend. Obtener en: https://resend.com/api-keys
# Sin esto: no se envían emails post-quiz (funnel sigue funcionando).
RESEND_API_KEY=

# Email From. Debe ser un dominio verificado en Resend.
# Formato: "Nombre <email@dominio.com>"
RESEND_FROM_EMAIL=Protocolo Anti-Hinchazón <hola@anti-hinchazon.com>

# URL base del sitio (para links en los emails)
NEXT_PUBLIC_SITE_URL=https://anti-hinchazon.com

# Hotmart Product IDs (para mapear webhook → tier de acceso)
# HOTMART_PRODUCT_ID_FRONT=xxxxxxx
# HOTMART_PRODUCT_ID_BUMP=xxxxxxx
# HOTMART_PRODUCT_ID_UPSELL=xxxxxxx

# URL de la app (para magic links redirect)
# NEXT_PUBLIC_APP_URL=https://tudominio.com
