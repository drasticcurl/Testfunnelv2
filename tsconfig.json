{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "components/quiz-v2/SlideAgeSelector.tsx",
    "components/quiz-v2/SlideAuthorityVideo.tsx",
    "components/quiz-v2/SlideLandingCover.tsx",
    "components/quiz-v2/SlideLoadingWithQuestions.tsx",
    "components/quiz-v2/SlidePlanPreview.tsx",
    "components/quiz-v2/SlideProfileResult.tsx",
    "components/quiz-v2/SlideSalesPage.tsx",
    "components/quiz-v2/SlideSocialProof.tsx",
    "components/quiz-v2/SlideWeeklyPlan.tsx",
    "components/quiz-v2/QuizProgressV2.tsx"
  ]
}
